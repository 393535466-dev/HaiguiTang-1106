<view class="game-page">
  <view wx:if="{{loading}}" class="loading-page"><view class="loading-symbol serif">汤</view><view class="loading-title serif">打开你的推理手账</view><view class="muted">正在恢复这段故事…</view></view>
  <view wx:elif="{{!session}}" class="empty-page"><view class="eyebrow">STORY NOT READY</view><view class="empty-title serif">这碗汤还没盛好</view><view class="empty-copy">{{error || '没有找到这一局，回首页重新选择故事。'}}</view><button class="primary" bindtap="home">回到故事列表</button><button class="text-link" bindtap="initialize">重新检查连接</button></view>
  <block wx:else>
    <view class="game-header"><button class="back-button" bindtap="home" aria-label="返回故事列表">‹</button><view class="game-heading"><view class="game-kicker">你的推理手账</view><view class="game-title serif">{{session.title}}</view></view><button class="more-toggle" bindtap="more" aria-label="更多操作">···</button></view>
    <view class="surface-card"><view class="surface-top"><text class="surface-label">汤 面</text><text class="pill">{{session.difficulty}}</text><button class="surface-toggle" bindtap="toggleSurface">{{surfaceExpanded ? '收起 −' : '展开 +'}}</button></view><view class="surface-body serif {{surfaceExpanded ? 'expanded' : ''}}">{{session.surface}}</view></view>
<view class="host-voice-bar"><button bindtap="toggleHostVoice" disabled="{{recording}}">{{hostVoiceEnabled ? '人声已开 · 关闭' : '开启自然人声'}}</button><button bindtap="readSurface" disabled="{{recording}}">听题</button><button bindtap="replayHostVoice" disabled="{{recording}}">重播</button></view><view wx:if="{{hostVoiceStatus}}" class="host-voice-status">{{hostVoiceStatus}}</view>
    <view class="ledger-bar">
      <text>{{session.maxQuestions ? '剩余提问 ' + session.remainingQuestions + ' / ' + session.maxQuestions : '有效提问 ' + (session.questionCount || 0)}}</text>
      <text class="ledger-dot">·</text><text>提示 {{session.hintCount || 0}} / 3</text>
      <text class="ledger-state">{{session.ended ? '本局已结束' : '推理中'}}</text>
    </view>
    <scroll-view class="message-scroll" scroll-y scroll-into-view="{{scrollTarget}}" scroll-with-animation>
      <view class="message-content">
        <view wx:if="{{!session.messages.length && !session.ended}}" class="first-question"><view class="first-symbol serif">?</view><view class="first-title serif">从一个小问题开始</view><view class="first-copy">例如「故事里只有一个人吗？」<text class="copy-line">一次问一件事，答案会更清楚。</text></view></view>
        <view wx:for="{{session.messages}}" wx:key="id" class="message-entry" id="message-{{item.id}}">
          <view class="entry-order"><text class="entry-no">{{item.displayOrder}}</text><text class="entry-type">{{item.type === 'guess' ? '我的完整猜底' : '我的问题'}}</text><button class="entry-feedback" bindtap="feedback" data-id="{{item.id}}" aria-label="反馈本条判定">有疑问？</button></view>
          <view class="entry-question">{{item.text}}</view>
          <view wx:if="{{item.isQuestionPrompt}}" class="answer-note">{{item.answerLabel}}。{{item.answerNote}}</view>
          <view wx:else class="answer-row"><view class="answer-mark {{item.isPositive ? 'positive' : ''}}">{{item.answerLabel}}</view><text class="answer-note">{{item.answerNote}}</text></view>
        </view>
        <view wx:if="{{session.hints.length}}" class="hints-panel"><view class="hints-heading"><text class="hint-symbol">✦</text><text>你解锁的线索</text></view><view wx:for="{{session.hints}}" wx:key="index" class="hint-text"><text class="hint-number">{{index + 1}}</text><text>{{item}}</text></view></view>
        <view wx:if="{{session.ended}}" class="ending">
          <view class="ending-stamp">{{session.isSolved ? '真相已寻回' : '故事已揭晓'}}</view>
          <view class="ending-title serif">{{session.isSolved ? '原来，是这样。' : '再看一眼故事的另一面。'}}</view>
          <view wx:if="{{session.reachedQuestionLimit}}" class="answer-note">有效提问次数已用完，本局自动揭底。</view>
          <view wx:if="{{session.solution}}" class="solution-body">{{session.solution}}</view>
          <view wx:else class="solution-body">本局已作废或到期，请回到首页开启新的故事。</view>
          <view class="ending-meta">{{session.ranked ? '本局得分 ' + session.points + ' · 已计入单人榜' : '本次为重玩或旧版对局，不重复计分'}}</view><button class="text-link" bindtap="leaderboard">查看单人榜 ↗</button><view class="ending-meta">{{session.questionCount || 0}} 次有效提问 · {{session.hintCount || 0}} 条线索</view>
          <button class="primary" bindtap="home">再挑一碗汤 ↗</button><button class="text-link" bindtap="feedback">反馈题目问题</button>
        </view>
        <view id="message-end" class="message-end"></view>
      </view>
    </scroll-view>
    <view wx:if="{{!session.ended}}" class="composer">
      <view class="composer-toolbar"><view class="mode-switch"><button class="mode-item {{mode === 'question' ? 'selected' : ''}}" bindtap="switchMode" data-mode="question" disabled="{{busy || recording}}">继续提问</button><button class="mode-item {{mode === 'guess' ? 'selected' : ''}}" bindtap="switchMode" data-mode="guess" disabled="{{busy || recording}}">我猜到了</button></view><button class="hint-button" bindtap="hint" disabled="{{session.hintCount >= 3}}">✦ 提示 {{session.hintCount || 0}}/3</button></view>
      <view wx:if="{{error}}" class="inline-error">{{error}}</view>
      <view wx:if="{{statusText}}" class="processing-line"><view wx:if="{{busy}}" class="processing-dot"></view><text>{{statusText}}</text></view>
      <view wx:if="{{pending && !busy}}" class="pending-actions"><button bindtap="checkResult">检查已有结果</button><button wx:if="{{pending.retryable !== false}}" bindtap="retry">主动重试一次 ↗</button></view>
      <view wx:if="{{recoveredTranscript}}" class="recovered-transcript"><text>识别结果可用，当前草稿已保留。</text><button bindtap="useRecoveredTranscript">使用识别文字 ↗</button></view>
      <view class="draft-container"><view class="draft-top"><text>{{draftSource === 'voice' || draftSource === 'edited' ? '核对人名、数字和否定词' : (mode === 'guess' ? '讲清你理解的完整故事' : '把好奇写下来')}}</text><text>{{draft.length}} / {{mode === 'guess' ? 500 : 200}}</text></view><textarea class="draft-input" value="{{draft}}" bindinput="onInput" placeholder="{{mode === 'guess' ? '谁做了什么，为什么会这样？' : '他是故意这样做的吗？'}}" placeholder-style="color:#a1aa98" maxlength="{{mode === 'guess' ? 500 : 200}}" disabled="{{recording}}" adjust-position="true" cursor-spacing="24" show-confirm-bar="false" auto-height="false"></textarea></view>
      <view class="input-actions"><button class="record-button {{recording ? 'recording' : ''}} {{cancelling ? 'cancelling' : ''}}" bindtouchstart="recordStart" catchtouchmove="recordMove" bindtouchend="recordEnd" bindtouchcancel="recordCancel" disabled="{{busy}}" aria-label="按住录音，松手转文字，上滑取消"><view class="mic-icon"><view></view></view><text>{{recording ? (cancelling ? '松手取消' : '录音中 ' + recordSeconds + 's · 上滑取消') : ((draftSource === 'voice' || draftSource === 'edited') ? '按住重录' : '按住说话')}}</text></button><button class="send-button" bindtap="submit" disabled="{{busy || recording || !draft}}">{{mode === 'guess' ? '提交猜底' : '确认提问'}} <text>↑</text></button></view>
      <view class="composer-footer"><text>{{session.maxQuestions ? '用完提问次数后自动揭底' : '录音最长约20秒，确认文字后才判题'}}</text><button bindtap="reveal">放弃揭底</button></view>
    </view>
    <view wx:else class="ended-toolbar"><button bindtap="clear">清空本局记录</button><button bindtap="privacy">录音与隐私说明</button></view>
  </block>
</view>
<view wx:if="{{privacyNeeded}}" class="privacy-backdrop"><view class="privacy-dialog"><view class="privacy-title serif">开麦之前，先说清楚</view><view class="privacy-body">只在你主动按住时录音。录音将发送到云端及第三方识别服务，转成文字供你确认。你也可以用文字继续。</view><button class="text-link" bindtap="privacy">阅读录音与隐私说明</button><button id="agree-privacy" class="primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agreePrivacy">同意并继续</button><button class="secondary" bindtap="declinePrivacy">暂不使用语音</button></view></view>
