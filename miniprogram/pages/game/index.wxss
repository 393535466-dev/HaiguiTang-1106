.game-page{height:100vh;display:flex;flex-direction:column;background:#f4f1e9}.game-header{display:flex;align-items:center;gap:14rpx;padding:20rpx 30rpx 22rpx;flex-shrink:0}.back-button{font-size:55rpx;line-height:62rpx;width:35rpx;text-align:left}.game-heading{flex:1;min-width:0}.game-kicker{font-size:17rpx;letter-spacing:3rpx;color:#8c977f}.game-title{font-size:33rpx;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.45;margin-top:3rpx}.surface-card{margin:0 30rpx;background:#e7ebdd;border:1rpx solid #d3ddc7;border-radius:15rpx;padding:21rpx 25rpx;flex-shrink:0}.surface-top{display:flex;align-items:center;gap:15rpx}.surface-label{color:#758762;font-size:18rpx;letter-spacing:4rpx}.surface-top .pill{font-size:17rpx;padding:3rpx 11rpx;border-color:#c6d1b8}.surface-toggle{margin-left:auto;font-size:18rpx;color:#7e8e70;padding:2rpx 0}.surface-body{font-size:27rpx;line-height:1.85;margin-top:12rpx;max-height:150rpx;overflow:hidden;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical}.surface-body.expanded{max-height:310rpx;-webkit-line-clamp:6;overflow:auto}.ledger-bar{display:flex;align-items:center;gap:13rpx;margin:19rpx 35rpx 7rpx;color:#8c977f;font-size:19rpx;flex-shrink:0}.ledger-dot{color:#b3bba8}.ledger-state{margin-left:auto;color:#70866a}.message-scroll{flex:1;height:0;min-height:100rpx}.message-content{padding:13rpx 34rpx 10rpx}.first-question{text-align:center;padding:50rpx 25rpx 45rpx}.first-symbol{height:74rpx;width:74rpx;line-height:70rpx;border:1rpx solid #ced8c0;border-radius:50%;font-size:49rpx;color:#aab79a;margin:0 auto 20rpx}.first-title{font-size:30rpx;color:#708166}.first-copy{font-size:23rpx;color:#9ba38f;line-height:1.85;margin-top:11rpx}.copy-line{display:block}.message-entry{padding:24rpx 0;border-bottom:1rpx dashed #d7decd}.entry-order{display:flex;gap:14rpx;align-items:center}.entry-no{font-size:18rpx;color:#94a185}.entry-type{font-size:18rpx;color:#8a9780;letter-spacing:1rpx}.entry-feedback{font-size:17rpx;color:#a2a994;margin-left:auto}.entry-question{font-size:28rpx;line-height:1.75;color:#304d3f;margin:11rpx 0 16rpx;word-break:break-all}.answer-row{display:flex;align-items:center;gap:16rpx}.answer-mark{font-size:23rpx;font-weight:600;color:#926347;background:#ece4d5;line-height:1.4;padding:9rpx 18rpx;border-radius:9rpx;flex-shrink:0}.answer-mark.positive{color:#34644c;background:#e0e8d8}.answer-note{font-size:21rpx;line-height:1.6;color:#87927d}.hints-panel{margin:25rpx 0;background:#eee8d8;border:1rpx solid #dfd4b9;border-radius:13rpx;padding:23rpx}.hints-heading{display:flex;gap:12rpx;color:#967b50;font-size:21rpx;font-weight:500;margin-bottom:9rpx}.hint-symbol{font-size:23rpx}.hint-text{display:flex;gap:13rpx;font-size:24rpx;line-height:1.8;color:#87785b;padding-top:9rpx}.hint-number{color:#b8a47f;flex-shrink:0}.message-end{height:12rpx}.composer{padding:17rpx 29rpx calc(12rpx + env(safe-area-inset-bottom));border-top:1rpx solid #d9dece;background:#f8f6ee;flex-shrink:0;box-shadow:0 -8rpx 30rpx rgba(60,75,42,.025)}.composer-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-bottom:17rpx}.mode-switch{display:flex;gap:6rpx;background:#ebeede;padding:5rpx;border-radius:10rpx}.mode-item{padding:10rpx 19rpx;font-size:23rpx;color:#929d84;border-radius:7rpx}.mode-item.selected{background:#fbfaf4;color:#416044;box-shadow:0 1rpx 7rpx rgba(20,50,20,.05)}.hint-button{font-size:22rpx;color:#9a7953;padding:7rpx 3rpx}.draft-container{border:1rpx solid #d1dbc4;background:#fdfbf4;border-radius:13rpx;padding:15rpx 21rpx 10rpx}.draft-top{display:flex;justify-content:space-between;gap:12rpx;color:#94a084;font-size:18rpx;margin-bottom:7rpx}.draft-input{width:100%;height:87rpx;font-size:26rpx;line-height:1.7;color:#35503f;padding:0;min-height:87rpx}.input-actions{display:flex;gap:15rpx;margin-top:15rpx}.record-button{border:1rpx solid #b8c7a7;display:flex;align-items:center;justify-content:center;gap:14rpx;border-radius:12rpx;padding:22rpx 13rpx;font-size:25rpx;color:#59764b;flex:1;min-width:0;user-select:none;-webkit-user-select:none}.record-button.recording{background:#e2ead4;border-color:#76915e;font-size:21rpx}.record-button.cancelling{background:#f0ded5;border-color:#ba8b74;color:#9a5544}.mic-icon{width:19rpx;height:29rpx;position:relative;border:2rpx solid currentColor;border-top:0;border-radius:0 0 12rpx 12rpx;flex-shrink:0}.mic-icon view{position:absolute;width:9rpx;height:22rpx;border:2rpx solid currentColor;border-radius:7rpx;left:3rpx;top:-6rpx;background:transparent}.mic-icon:after{content:'';width:2rpx;height:7rpx;position:absolute;background:currentColor;left:7rpx;top:25rpx}.send-button{background:#285340;color:#f9f8ed;border-radius:12rpx;display:flex;align-items:center;justify-content:center;gap:24rpx;flex:1;padding:22rpx 16rpx;font-size:25rpx;font-weight:500}.send-button text{font-size:30rpx;line-height:1}.composer-footer{display:flex;justify-content:space-between;align-items:center;gap:8rpx;margin-top:13rpx;color:#a1aa94;font-size:17rpx}.composer-footer button{font-size:18rpx;color:#9a846a;padding:3rpx}.inline-error{font-size:21rpx;line-height:1.6;color:#a25d44;background:#f5e8dc;padding:12rpx 17rpx;border-radius:8rpx;margin:0 0 12rpx}.processing-line{display:flex;align-items:center;gap:10rpx;font-size:20rpx;color:#7a876c;margin:0 0 11rpx;line-height:1.6}.processing-dot{height:9rpx;width:9rpx;flex-shrink:0;border-radius:50%;background:#7b9363;animation:breathe 1.2s infinite}.pending-actions{display:flex;gap:22rpx;margin-bottom:13rpx}.pending-actions button{font-size:20rpx;color:#8b6e4f;text-decoration:underline}.ending{margin:30rpx 0 25rpx;padding:31rpx 25rpx;text-align:center;background:#edf0e2;border:1rpx solid #d2dcc2;border-radius:15rpx}.ending-stamp{display:inline-block;padding:5rpx 16rpx;border:2rpx solid #9b6650;color:#9b6650;font-size:19rpx;letter-spacing:4rpx;transform:rotate(-4deg)}.ending-title{font-size:39rpx;font-weight:600;line-height:1.55;margin-top:25rpx}.solution-body{text-align:left;white-space:pre-wrap;font-size:27rpx;line-height:1.9;margin:22rpx 0;color:#5a6d4e}.ending-meta{font-size:20rpx;color:#8b997c;margin:23rpx 0}.ending .primary{font-size:26rpx;padding:24rpx 20rpx}.ending .text-link{margin-top:16rpx;font-size:22rpx}.ended-toolbar{display:flex;justify-content:space-between;flex-shrink:0;padding:18rpx 35rpx calc(18rpx + env(safe-area-inset-bottom));border-top:1rpx solid #d6ddca}.ended-toolbar button{font-size:21rpx;color:#8d927e}.loading-page,.empty-page{padding:110rpx 50rpx;text-align:center}.loading-symbol{height:100rpx;width:100rpx;border:1rpx solid #a5b994;border-radius:50%;font-size:49rpx;line-height:95rpx;margin:0 auto 30rpx}.loading-title{font-size:35rpx;margin-bottom:12rpx}.empty-title{font-size:44rpx;line-height:1.6;margin:26rpx 0}.empty-copy{font-size:26rpx;color:#8b9781;margin-bottom:35rpx}.empty-page .text-link{margin-top:22rpx}@keyframes breathe{0%,100%{opacity:.35}50%{opacity:1}}
.more-toggle{font-size:30rpx;line-height:1;width:33rpx;color:#7d8b70;padding:10rpx 0}
.recovered-transcript{font-size:20rpx;color:#7b826d;line-height:1.6;margin-bottom:12rpx;padding:12rpx 15rpx;background:#edeee1;border-radius:8rpx}.recovered-transcript button{font-size:20rpx;color:#8b6e4f;text-align:left;margin-top:5rpx;text-decoration:underline}
