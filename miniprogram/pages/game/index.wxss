.game-page{height:100vh;display:flex;flex-direction:column;background:#f6f3eb;overflow-y:auto}
.game-header{display:flex;align-items:center;gap:15rpx;padding:20rpx 29rpx 21rpx;flex-shrink:0}
.back-button{font-size:53rpx;line-height:64rpx;width:45rpx;text-align:left;min-height:64rpx}
.game-heading{flex:1;min-width:0}
.game-kicker{font-size:20rpx;letter-spacing:2rpx;color:#7c896f}
.game-title{font-size:37rpx;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.4;margin-top:4rpx}
.more-toggle{font-size:33rpx;line-height:1;width:55rpx;min-height:64rpx;color:#738367;padding:10rpx 0}
.surface-card{margin:0 29rpx;background:#e8edde;border:1rpx solid #d3ddc6;border-radius:19rpx;padding:20rpx 25rpx;flex-shrink:0}
.surface-top{display:flex;align-items:center;gap:15rpx}
.surface-label{color:#657e54;font-size:21rpx;letter-spacing:3rpx}
.surface-top .pill{font-size:19rpx;padding:3rpx 11rpx;border-color:#bccdaf}
.surface-toggle{margin-left:auto;font-size:21rpx;color:#6c815c;padding:4rpx 0;min-height:38rpx}
.surface-body{font-size:30rpx;line-height:1.85;margin-top:12rpx;max-height:167rpx;overflow:hidden;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical}
.surface-body.expanded{max-height:320rpx;overflow:auto;display:block;-webkit-line-clamp:unset}
.ledger-bar{display:flex;align-items:center;gap:13rpx;margin:12rpx 34rpx 6rpx;color:#728267;font-size:21rpx;flex-shrink:0}
.ledger-dot{color:#a8b49a}
.ledger-state{margin-left:auto;color:#52794e;font-size:20rpx;white-space:nowrap}
.message-scroll{flex:1;height:0;min-height:100rpx}
.message-content{padding:16rpx 30rpx 10rpx}
.first-question{text-align:center;padding:42rpx 20rpx 36rpx}
.first-symbol{height:83rpx;width:83rpx;line-height:79rpx;border:1rpx solid #c5d1b6;border-radius:25rpx 25rpx 25rpx 5rpx;font-size:53rpx;color:#8da079;margin:0 auto 23rpx;transform:rotate(-6deg);background:#edf1e5}
.first-title{font-size:33rpx;color:#52734d}
.first-copy{font-size:24rpx;color:#7e8d70;line-height:1.85;margin-top:11rpx}
.copy-line{display:block}
.message-entry{padding:24rpx 24rpx 25rpx;background:#fffdf7;border:1rpx solid #dce2d2;border-radius:20rpx;margin-bottom:20rpx}
.entry-order{display:flex;gap:12rpx;align-items:center}
.entry-no{font-size:21rpx;color:#93a180;font-family:serif}
.entry-type{font-size:21rpx;color:#697f5d;letter-spacing:1rpx}
.entry-feedback{font-size:21rpx;color:#99846a;margin-left:auto;min-height:38rpx}
.entry-question{font-size:30rpx;line-height:1.75;color:#294b3a;margin:9rpx 0 18rpx;word-break:break-all}
.answer-header{display:flex;align-items:center;gap:10rpx;border-top:1rpx dashed #dce1d1;padding-top:17rpx;font-size:21rpx;color:#7e8b70}
.answer-avatar{display:flex;align-items:center;justify-content:center;width:31rpx;height:31rpx;background:#345540;border-radius:8rpx;color:#f5eed6;font-size:18rpx}
.answer-row{display:flex;align-items:center;gap:16rpx;margin-top:13rpx}
.answer-mark{font-size:26rpx;font-weight:600;color:#95613f;background:#f0e7d8;line-height:1.5;padding:8rpx 17rpx;border-radius:9rpx;flex-shrink:0}
.answer-mark.positive{color:#3d683c;background:#e3ecd7}
.answer-note{font-size:24rpx;line-height:1.75;color:#6e8062}
.prompt-note{margin-top:14rpx;background:#f0efdf;border-left:3rpx solid #b0b78c;border-radius:0 10rpx 10rpx 0;padding:13rpx 17rpx;color:#7b7b57}
.hints-panel{margin:25rpx 0;background:#f1ead9;border:1rpx solid #e0d2b3;border-radius:18rpx;padding:24rpx}
.hints-heading{display:flex;gap:12rpx;color:#9d7947;font-size:24rpx;font-weight:500;margin-bottom:9rpx}
.hint-symbol{font-size:25rpx}
.hint-text{display:flex;gap:13rpx;font-size:26rpx;line-height:1.85;color:#7c704f;padding-top:12rpx}
.hint-number{color:#b29b70;flex-shrink:0}
.message-end{height:12rpx}
.composer{padding:15rpx 29rpx calc(12rpx + env(safe-area-inset-bottom));border-top:1rpx solid #d5ddc8;background:#fcfaf3;flex-shrink:0;box-shadow:0 -8rpx 30rpx #3c4b2a05}
.composer-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-bottom:13rpx}
.mode-switch{display:flex;gap:5rpx;background:#e9eddf;padding:5rpx;border-radius:13rpx}
.mode-item{padding:12rpx 18rpx;font-size:25rpx;color:#7b8b6b;border-radius:9rpx;min-height:57rpx}
.mode-item.selected{background:#fffdf7;color:#365b3c;box-shadow:0 2rpx 7rpx #1432140a}
.hint-button{font-size:23rpx;color:#977648;padding:10rpx 0;min-height:54rpx}
.draft-container{border:1rpx solid #cad6bc;background:#fffdf7;border-radius:15rpx;padding:13rpx 19rpx 7rpx}
.draft-top{display:flex;justify-content:space-between;gap:10rpx;color:#7d8b6d;font-size:20rpx;margin-bottom:7rpx;line-height:1.6}
.draft-top text:last-child{white-space:nowrap}
.draft-input{width:100%;height:83rpx;font-size:29rpx;line-height:1.7;color:#2e4d3a;padding:0;min-height:83rpx;background:transparent}
.is-recording .draft-container{background:#eff4e5;border-color:#8fa779}
.input-actions{display:flex;gap:13rpx;margin-top:13rpx}
.record-button{border:1rpx solid #b7c7a5;display:flex;align-items:center;justify-content:center;gap:14rpx;border-radius:14rpx;padding:22rpx 12rpx;font-size:26rpx;color:#587449;flex:1;min-width:0;min-height:81rpx;user-select:none;-webkit-user-select:none;touch-action:none}
.record-button.recording{background:#e0ead3;border-color:#789760;font-size:22rpx}
.record-button.cancelling{background:#f2e1d6;border-color:#bc8c73;color:#9b523e}
.mic-icon{width:19rpx;height:29rpx;position:relative;border:2rpx solid currentColor;border-top:0;border-radius:0 0 12rpx 12rpx;flex-shrink:0}
.mic-icon view{position:absolute;width:9rpx;height:22rpx;border:2rpx solid currentColor;border-radius:7rpx;left:3rpx;top:-6rpx;background:transparent}
.mic-icon:after{content:'';width:2rpx;height:7rpx;position:absolute;background:currentColor;left:7rpx;top:25rpx}
.send-button{background:#28503d;color:#fff9eb;border-radius:14rpx;display:flex;align-items:center;justify-content:center;gap:24rpx;flex:1;padding:22rpx 14rpx;font-size:26rpx;font-weight:500;min-height:81rpx}
.send-button text{font-size:31rpx;line-height:1}
.composer-footer{display:flex;justify-content:space-between;align-items:center;gap:8rpx;margin-top:9rpx;color:#839174;font-size:20rpx}
.composer-footer button{font-size:21rpx;color:#99805c;padding:8rpx 0;white-space:nowrap}
.inline-error{font-size:23rpx;line-height:1.6;color:#9d553c;background:#f3e6da;padding:12rpx 17rpx;border-radius:10rpx;margin:0 0 12rpx;max-height:115rpx;overflow:auto}
.processing-line{display:flex;align-items:center;gap:10rpx;font-size:23rpx;color:#6e835c;margin:0 0 11rpx;line-height:1.6}
.processing-dot{height:10rpx;width:10rpx;flex-shrink:0;border-radius:50%;background:#7b9363;animation:breathe 1.2s infinite}
.pending-actions{display:flex;gap:22rpx;margin-bottom:10rpx}
.pending-actions button{font-size:23rpx;color:#927347;padding:7rpx 0}
.ending{margin:25rpx 0;padding:32rpx 26rpx;text-align:center;background:#e9efdf;border:1rpx solid #ccd9bd;border-radius:21rpx}
.ending-stamp{display:inline-block;padding:5rpx 16rpx;border:2rpx solid #a16649;color:#a16649;font-size:21rpx;letter-spacing:4rpx;transform:rotate(-4deg);border-radius:4rpx}
.ending-title{font-size:43rpx;font-weight:600;line-height:1.5;margin-top:27rpx}
.solution-body{text-align:left;white-space:pre-wrap;font-size:29rpx;line-height:1.9;margin:24rpx 0;color:#46643e}
.ending-meta{font-size:23rpx;color:#728663;margin:20rpx 0}
.ending .primary{font-size:27rpx;padding:24rpx 20rpx;width:100%}
.ending .text-link{margin-top:11rpx;font-size:23rpx}
.ended-toolbar{display:flex;justify-content:space-between;flex-shrink:0;padding:16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));border-top:1rpx solid #d6ddca}
.ended-toolbar button{font-size:23rpx;color:#7e8b70;padding:8rpx 0}
.loading-page,.empty-page{padding:100rpx 45rpx;text-align:center}
.loading-symbol{height:100rpx;width:100rpx;border:1rpx solid #a5b994;border-radius:50%;font-size:49rpx;line-height:95rpx;margin:0 auto 30rpx}
.loading-title{font-size:37rpx;margin-bottom:12rpx}
.empty-title{font-size:45rpx;line-height:1.6;margin:26rpx 0}
.empty-copy{font-size:27rpx;color:#788b6c;margin-bottom:35rpx}
.empty-page .primary{width:100%}
.empty-page .text-link{margin-top:22rpx}
.recovered-transcript{font-size:22rpx;color:#748266;line-height:1.7;margin-bottom:12rpx;padding:12rpx 15rpx;background:#edeee1;border-radius:10rpx}
.recovered-transcript button{font-size:23rpx;color:#8b6e4f;text-align:left;margin-top:5rpx;padding:7rpx 0}
@keyframes breathe{0%,100%{opacity:.35}
50%{opacity:1}
}

@media(max-height:700px){.game-header{padding-top:10rpx;padding-bottom:12rpx}
.game-title{font-size:32rpx}
.surface-card{padding-top:10rpx;padding-bottom:13rpx}
.surface-body:not(.expanded){-webkit-line-clamp:2;max-height:106rpx;margin-top:6rpx}
.host-voice-bar{padding-top:0;padding-bottom:0}
.host-voice-bar button{min-height:46rpx;padding:7rpx 0}
.ledger-bar{margin-top:6rpx}
.composer{padding-top:10rpx}
.composer-toolbar{margin-bottom:9rpx}
.draft-input{height:67rpx;min-height:67rpx}
.record-button,.send-button{padding:18rpx 10rpx;min-height:73rpx}
.first-question{padding:24rpx 15rpx}
.first-symbol{width:65rpx;height:65rpx;font-size:41rpx;line-height:60rpx;margin-bottom:12rpx}
}

@media(prefers-reduced-motion:reduce){.processing-dot{animation:none}
}

.input-actions button{min-height:44px}
.mode-item{min-height:36px}
.back-button,.more-toggle{min-width:38px;min-height:44px}
