.home-scroll{height:100vh}
.home-page{padding:34rpx 34rpx 24rpx}
.brand{display:flex;align-items:center;gap:16rpx;margin-bottom:37rpx}
.brand-mark{width:68rpx;height:68rpx;background:#234c3e;color:#f7f2df;border-radius:22rpx 22rpx 22rpx 4rpx;display:flex;align-items:center;justify-content:center;font-size:36rpx}
.brand-name{font-size:30rpx;font-weight:600;letter-spacing:2rpx}
.brand-sub{font-size:20rpx;letter-spacing:3rpx;margin-top:2rpx;color:#7c8474}
.brand-rank{margin-left:auto;display:flex;align-items:center;gap:9rpx;font-size:23rpx;min-height:72rpx;padding:10rpx 0 10rpx 16rpx;color:#647558}
.rank-symbol{font-size:36rpx}
.hero{position:relative;padding:32rpx 30rpx 25rpx;background:#e9ecdf;border:1rpx solid #d9dfce;border-radius:26rpx;overflow:hidden}
.hero-eyebrow{display:flex;align-items:center;gap:11rpx;font-size:21rpx;letter-spacing:2rpx;color:#627956}
.tiny-star{color:#a7583d;font-size:22rpx}
.hero-title{font-size:74rpx;font-weight:600;line-height:1.2;letter-spacing:3rpx;margin:26rpx 0 21rpx;position:relative;z-index:2}
.title-break,.copy-break{display:block}
.hero-copy{font-size:25rpx;line-height:1.8;color:#69785e;position:relative;z-index:2}
.bowl-scene{position:absolute;width:265rpx;height:265rpx;right:-7rpx;top:87rpx}
.orbit{position:absolute;border:1rpx solid #c9d1b8;border-radius:50%}
.orbit-one{width:254rpx;height:254rpx;top:0;right:-12rpx}
.orbit-two{width:218rpx;height:218rpx;top:18rpx;right:6rpx}
.bowl-rim{position:absolute;z-index:4;width:181rpx;height:36rpx;border-radius:50%;left:35rpx;top:101rpx;background:#203f33;border:8rpx solid #66806a}
.bowl-body{position:absolute;z-index:3;width:181rpx;height:104rpx;left:35rpx;top:116rpx;border-radius:0 0 100rpx 100rpx;background:#2a4e3b;border-bottom:3rpx solid #1d392e}
.bowl-question{display:block;color:#e3dcb7;font-size:62rpx;line-height:99rpx;text-align:center}
.bowl-foot{position:absolute;width:64rpx;height:12rpx;top:217rpx;left:93rpx;background:#2a4e3b;border-radius:0 0 10rpx 10rpx;z-index:2}
.bowl-shadow{width:162rpx;height:13rpx;position:absolute;top:232rpx;left:44rpx;background:#cfd6c0;border-radius:50%}
.steam{height:59rpx;width:21rpx;position:absolute;border-left:3rpx solid #91a47e;border-radius:50%;top:31rpx;transform:rotate(13deg)}
.steam-one{left:101rpx}
.steam-two{left:139rpx;top:22rpx}
.scene-spark{position:absolute;right:36rpx;top:29rpx;color:#a56a47;font-size:24rpx}
.bowl-seal{position:absolute;z-index:5;right:25rpx;top:218rpx;border:2rpx solid #ab6249;color:#a65b43;border-radius:4rpx;padding:5rpx;line-height:1.2;font-size:20rpx;letter-spacing:3rpx;transform:rotate(7deg)}
.hero-button{margin-top:31rpx;position:relative;z-index:3;display:flex;justify-content:space-between;text-align:left;align-items:center;width:100%;font-size:29rpx;padding:25rpx 29rpx}
.arrow{font-size:34rpx;font-weight:400}
.hero-meta{display:flex;justify-content:center;gap:15rpx;font-size:21rpx;color:#718165;margin-top:17rpx}
.social-entry{margin:22rpx 0 0}
.friends-entry{display:flex;align-items:center;gap:25rpx;text-align:left;padding:25rpx 27rpx;background:#fffdf7;border:1rpx solid #d6ddce;width:100%;border-radius:20rpx}
.friends-entry>view:last-child{flex:1}
.entry-title{font-size:29rpx;font-weight:600;display:flex;justify-content:space-between;gap:12rpx}
.entry-title text{font-weight:400;color:#6c7a60}
.entry-copy{font-size:23rpx;color:#73806b;margin-top:8rpx}
.friends-icon{position:relative;width:62rpx;height:57rpx;flex-shrink:0}
.friends-icon view{position:absolute;width:36rpx;height:33rpx;border:2rpx solid #68805d;border-radius:17rpx 17rpx 3rpx 3rpx;bottom:0;left:0;background:#e8eddf}
.friends-icon view:before{content:'';position:absolute;width:21rpx;height:21rpx;top:-21rpx;left:5rpx;border:2rpx solid #68805d;border-radius:50%;background:#f6f3eb}
.friends-icon view:last-child{left:27rpx;bottom:4rpx;background:#f6f3eb}
.tutorial-entry{display:flex;align-items:center;gap:18rpx;width:100%;padding:26rpx 7rpx 29rpx;text-align:left;margin-bottom:18rpx}
.tutorial-icon{border:1rpx solid #c7c9b6;color:#8a7552;font-family:serif;border-radius:50%;width:47rpx;height:47rpx;line-height:45rpx;text-align:center;flex-shrink:0}
.tutorial-entry-title{font-size:25rpx;font-weight:500}
.tutorial-entry-copy{font-size:22rpx;color:#77826d;margin-top:4rpx}
.tutorial-arrow{margin-left:auto;font-size:28rpx;color:#8a7552}
.section-heading{display:flex;align-items:flex-end;justify-content:space-between;border-top:1rpx solid #d9ddcf;padding-top:35rpx;margin-bottom:18rpx}
.section-title{font-size:47rpx;font-weight:600;margin-top:8rpx;letter-spacing:1rpx}
.story-count{font-size:22rpx;color:#718067;padding-bottom:9rpx}
.status-line{display:flex;align-items:center;gap:10rpx;font-size:21rpx;color:#6b7d64;margin-bottom:24rpx}
.status-dot{height:10rpx;width:10rpx;border-radius:50%;background:#b59a63;flex-shrink:0}
.status-dot.ready{background:#58835d}
.refresh{font-size:21rpx;margin-left:auto;padding:8rpx 0 8rpx 12rpx;color:#717c64}
.setup-notice{margin-bottom:24rpx}
.story-card{display:flex;width:100%;background:#fffdf7;border:1rpx solid #d7ddce;border-radius:21rpx;margin-bottom:22rpx;text-align:left;overflow:hidden;min-height:284rpx}
.story-card[disabled]{opacity:1}
.card-illustration{width:180rpx;flex-shrink:0;position:relative;background:#e8eadb;overflow:hidden}
.story-1 .card-illustration{background:#e9dfd1}
.story-2 .card-illustration{background:#dce6e1}
.art-number{position:absolute;font-size:48rpx;color:#718069;bottom:10rpx;left:18rpx;opacity:.55}
.ticket-art{position:absolute;top:54rpx;left:29rpx;width:124rpx;height:154rpx;background:#f8f2df;border:2rpx solid #8c9b77;transform:rotate(-13deg);border-radius:6rpx;padding:16rpx 11rpx;font-size:14rpx;letter-spacing:3rpx;color:#697c58}
.ticket-line{height:2rpx;background:#c7cbb5;margin-top:12rpx}
.ticket-line.short{width:60%}
.ticket-star{display:block;text-align:center;font-size:33rpx;margin-top:16rpx;border-top:2rpx dashed #c2c6ac;padding-top:9rpx}
.book-art{position:absolute;top:75rpx;left:25rpx;width:130rpx;height:104rpx;transform:rotate(-8deg);display:flex}
.book-art>view{width:65rpx;background:#f7f0de;border:2rpx solid #b19574;border-radius:8rpx 2rpx 2rpx 8rpx}
.book-art>view:last-of-type{transform:skewY(-8deg);border-radius:2rpx 8rpx 8rpx 2rpx}
.book-art text{position:absolute;top:-50rpx;right:7rpx;font-size:49rpx;color:#9e6247;transform:rotate(12deg)}
.photo-art{position:absolute;top:65rpx;left:27rpx;width:129rpx;height:146rpx;transform:rotate(9deg);background:#b6c6b5;border:10rpx solid #f9f5e9;border-bottom-width:28rpx;overflow:hidden;box-shadow:2rpx 4rpx 0 #cad1c3}
.photo-sun{position:absolute;top:15rpx;right:17rpx;width:20rpx;height:20rpx;border-radius:50%;background:#f2ebce}
.photo-hill{position:absolute;bottom:-20rpx;left:-25rpx;width:150rpx;height:70rpx;background:#819d87;transform:rotate(-25deg)}
.photo-art text{position:absolute;left:42rpx;top:34rpx;color:#f9f4e1;font-size:45rpx;font-family:serif}
.card-main{flex:1;min-width:0;padding:25rpx 22rpx 0}
.card-top{display:flex;align-items:center;gap:13rpx}
.card-top .pill{font-size:19rpx;padding:3rpx 12rpx}
.card-category{font-size:20rpx;color:#8a8977}
.card-title{font-size:34rpx;font-weight:600;line-height:1.4;margin-top:15rpx;letter-spacing:1rpx}
.card-teaser{font-size:24rpx;color:#6f7d6b;line-height:1.75;margin-top:11rpx;min-height:78rpx}
.card-bottom{display:flex;justify-content:space-between;align-items:center;border-top:1rpx solid #e3e5da;padding:16rpx 0;font-size:21rpx;color:#526c50;margin-top:18rpx}
.card-bottom text:last-child{font-size:26rpx}
.how-section{margin-top:42rpx;padding:29rpx;background:#eeeadd;border-radius:20rpx}
.how-heading{font-size:36rpx;margin-bottom:19rpx}
.how-row{display:flex;padding:17rpx 0;gap:22rpx;align-items:flex-start}
.how-no{font-size:21rpx;color:#a26847;line-height:42rpx;width:38rpx;flex-shrink:0}
.how-title{font-size:27rpx;font-weight:500}
.how-copy{font-size:23rpx;color:#74806a;margin-top:3rpx}
.home-footer{display:flex;flex-direction:column;align-items:center;margin-top:39rpx;text-align:center;color:#7d8674;font-size:22rpx;padding-bottom:calc(20rpx + env(safe-area-inset-bottom))}
.footer-mark{color:#819073;font-size:33rpx;margin-bottom:13rpx}
.home-footer button{margin-top:9rpx;font-size:22rpx;color:#96734f;padding:12rpx}
