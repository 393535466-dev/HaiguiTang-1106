<view class="paper-theme route-page {{artError ? 'art-error' : ''}} {{screen === 'cover' ? 'cover-page' : 'inner-page'}}">
  <block wx:if="{{screen === 'cover'}}">
    <image class="cover-art" src="/assets/brand/torn-eye-open-v3.jpg{{artRetry}}" binderror="coverAssetFailed" mode="aspectFill" data-frame="open" bindload="eyeFrameLoaded" aria-hidden="true"></image>
    <image class="cover-art eye-blink {{eyeReady && coverActive ? 'eye-ready' : ''}}" src="/assets/brand/torn-eye-closed-v3.jpg{{artRetry}}" binderror="coverAssetFailed" mode="aspectFill" data-frame="closed" bindload="eyeFrameLoaded" aria-hidden="true"></image>
    <button wx:if="{{artError}}" class="cover-art-retry" bindtap="retryCoverArt">重载画面 ↻</button>
    <view class="cover-brand"><image class="brand-logo" src="/assets/brand/logo-red-cyan-v7.png{{artRetry}}" binderror="coverAssetFailed" mode="aspectFit"></image><view class="brush">海龟汤</view></view>
    <view class="cover-heading"><view class="cover-kicker">LOOK CLOSER.</view><view class="cover-title brush">你看到的<text>未必是真相</text></view></view>
    <view class="cover-footer"><view class="cover-caption brush"><text>一个反常的故事</text><text>等你问出真相</text></view><button class="hero-button" bindtap="enter" aria-label="进入游戏"><image class="torn-button-art" src="/assets/brand/torn-kraft-v1.png{{artRetry}}" binderror="coverAssetFailed" mode="aspectFit" aria-hidden="true"></image><text class="entry-label brush">进入游戏</text></button><button class="cover-tutorial" bindtap="tutorial" aria-label="第一次玩？跟着做一遍">第一次玩？跟着做一遍</button><view class="cover-footnote">AI 主持 · 文字 / 语音 · 单人 / 好友</view><button class="cover-privacy" bindtap="privacy">录音与隐私说明</button></view>
  </block>
  <block wx:else>
    <view class="route-header"><button bindtap="back" aria-label="返回上一步">‹</button><view><image class="mini-logo" src="/assets/brand/logo-red-cyan-v7.png{{artRetry}}" binderror="coverAssetFailed" mode="aspectFit"></image><text>海龟汤</text></view><text class="route-step">{{screen === 'mode' ? '01 / 02' : '02 / 02'}}</text></view>
    <view wx:if="{{screen === 'mode'}}" class="mode-content">
      <view class="route-kicker">CHOOSE YOUR TABLE</view><view class="route-title serif">今晚，怎么探个究竟？</view><view class="route-copy">一个人追问，或和朋友一起找答案。</view>
      <view class="mode-cards"><button class="mode-card" bindtap="chooseStory"><view class="mode-number">01</view><view class="mode-card-copy"><view>独自推理</view><text>和 AI 主持，一问一答</text></view></button><button class="mode-card friends-card" bindtap="friends"><view class="mode-number">02</view><view class="mode-card-copy"><view>和朋友一起玩</view><text>2～6 人同桌，45 秒轮流提问</text></view></button></view>
      <button wx:if="{{continuing}}" class="resume-link" bindtap="resume">继续未完的单人故事 ↗</button>
      <view class="route-bottom"><button bindtap="leaderboard">查看排行榜 ↗</button><button bindtap="privacy">录音与隐私说明</button></view>
    </view>
    <view wx:else class="stories-content">
      <view class="route-kicker">PICK A MYSTERY</view><view class="route-title serif">从哪件怪事开始？</view>
      <view class="story-stage"><view class="story-meta"><text>STORY {{storyIndex + 1}}</text><text>{{puzzle ? puzzle.difficulty : '暂无题目'}}</text></view><view class="story-number serif" aria-hidden="true">{{storyIndex + 1}}</view><view class="story-card-title serif">{{puzzle ? puzzle.title : '正在整理故事'}}</view><view class="story-card-teaser">{{puzzle ? puzzle.teaser : '请稍后重新检查连接。'}}</view><view class="story-rule"></view><text class="story-stage-note">{{puzzle.genre || '轻推理'}} · 看似寻常，另有缘由</text></view>
      <view class="story-pagination"><button bindtap="moveStory" data-direction="-1" disabled="{{storyIndex === 0}}">← 上一题</button><text>{{puzzles.length ? storyIndex + 1 : 0}} / {{puzzles.length}}</text><button bindtap="moveStory" data-direction="1" disabled="{{storyIndex >= puzzles.length - 1}}">下一题 →</button></view>
      <view class="route-status"><view class="status-dot {{statusKind}}"></view><text>{{statusText}}</text><button bindtap="load" disabled="{{loading}}">刷新</button></view>
      <view wx:if="{{error}}" class="route-error">{{error}}</view><button class="story-card route-primary" bindtap="start" data-id="{{puzzle ? puzzle.id : ''}}" disabled="{{!canStart || !puzzle}}">开始这个故事 <text>↗</text></button>
    </view>
  </block>
</view>
<view wx:if="{{privacyNeeded}}" class="paper-theme privacy-backdrop"><view class="privacy-dialog"><view class="privacy-title serif">开麦之前，先说清楚</view><view class="privacy-body">仅在你主动按住时录音。录音会发送到云端及第三方识别服务，转成文字供你确认。</view><button class="text-link" bindtap="privacy">阅读录音与隐私说明</button><button id="agree-privacy" class="primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agreePrivacy">同意并继续</button><button class="secondary" bindtap="declinePrivacy">暂不使用语音</button></view></view>
