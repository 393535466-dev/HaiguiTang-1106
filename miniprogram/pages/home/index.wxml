<view class="paper-theme route-page {{artError ? 'art-error' : ''}} {{screen === 'cover' ? 'cover-page' : 'inner-page'}}">
  <block wx:if="{{screen === 'cover'}}">
    <image class="cover-art" src="/assets/brand/torn-eye-open-v3.jpg{{artRetry}}" binderror="coverAssetFailed" mode="aspectFill" data-frame="open" bindload="eyeFrameLoaded" aria-hidden="true"></image>
    <image class="cover-art eye-blink {{eyeReady && coverActive ? 'eye-ready' : ''}}" src="/assets/brand/torn-eye-closed-v3.jpg{{artRetry}}" binderror="coverAssetFailed" mode="aspectFill" data-frame="closed" bindload="eyeFrameLoaded" aria-hidden="true"></image>
    <button wx:if="{{artError}}" class="cover-art-retry" bindtap="retryCoverArt">重载画面 ↻</button>
    <view class="cover-brand"><image class="brand-logo" src="/assets/brand/logo-red-cyan-v7.png{{artRetry}}" binderror="coverAssetFailed" mode="aspectFit"></image><view class="brush">海龟汤</view></view>
    <view class="cover-heading"><view class="cover-title brush">你看到的<text>未必是真相</text></view><view class="cover-kicker" aria-label="LOOK CLOSER."><text>L</text><text>O</text><text>O</text><text>K</text><text> </text><text>C</text><text>L</text><text>O</text><text>S</text><text>E</text><text>R</text><text>.</text></view></view>
    <view class="cover-footer"><button class="hero-button" bindtap="enter" aria-label="进入游戏"><image class="torn-button-art" src="/assets/brand/torn-kraft-v1.png{{artRetry}}" binderror="coverAssetFailed" mode="aspectFit" aria-hidden="true"></image><text class="entry-label brush">进入游戏</text></button><button class="cover-tutorial" bindtap="tutorial" aria-label="新手试玩">新手试玩</button><button class="cover-privacy" bindtap="privacy">录音与隐私说明</button></view>
  </block>
  <block wx:else>
    <view class="route-header"><button bindtap="back" aria-label="返回上一步">‹</button><view><image class="mini-logo" src="/assets/brand/logo-red-cyan-v7.png{{artRetry}}" binderror="coverAssetFailed" mode="aspectFit"></image><text>海龟汤</text></view><view class="header-tools"><button class="tool-button" bindtap="leaderboard" aria-label="排行榜" disabled="{{recording || busy}}"><image src="/assets/brand/rank-gold-v2.png" mode="aspectFit" aria-hidden="true"></image></button><button class="tool-button" bindtap="settings" aria-label="设置" disabled="{{recording || busy}}"><image src="/assets/brand/settings-gold-v2.png" mode="aspectFit" aria-hidden="true"></image></button><button class="tool-button" bindtap="profile" aria-label="我的" disabled="{{recording || busy}}"><image src="/assets/brand/profile-gold-v2.png" mode="aspectFit" aria-hidden="true"></image></button></view></view>
    <view wx:if="{{screen === 'mode'}}" class="mode-content">
      <view class="route-kicker">CHOOSE YOUR TABLE</view><view class="route-title serif mode-main-title">今天，来一探究竟</view><view class="route-copy mode-copy">一个人追问，或和朋友一起找答案。</view>
      <view class="mode-cards"><button class="mode-card" bindtap="chooseStory"><view class="mode-number">01</view><view class="mode-card-copy"><view>独自推理</view><text>和 AI 主持，一问一答</text></view></button><button class="mode-card friends-card" bindtap="friends"><view class="mode-number">02</view><view class="mode-card-copy"><view>和朋友一起玩</view><text>2～6 人同桌，45 秒轮流提问</text></view></button></view>
      <view class="route-bottom"><button class="mode-privacy" bindtap="privacy">录音与隐私说明</button><button wx:if="{{continuing}}" class="resume-link" bindtap="resume">继续未完的单人故事</button></view>
    </view>
    <view wx:else class="stories-content">
      <view class="story-carousel " aria-label="左右滑动选择剧本"><view class="story-deck {{carouselDragging ? 'dragging' : ''}}" style="transform:translateX({{carouselShift}}px)"><button wx:for="{{carouselCards}}" wx:key="id" class="story-leaf {{item.position}}" data-index="{{item.index}}" bindtap="selectStoryCard" bindtouchstart="storyTouchStart" catchtouchmove="storyTouchMove" bindtouchend="storyTouchEnd" bindtouchcancel="storyTouchCancel" aria-label="{{item.index === storyIndex ? '开始《' + item.title + '》' : '选择《' + item.title + '》'}}" aria-pressed="{{item.index === storyIndex}}"><view class="book-picture"><image class="book-art" src="{{item.art}}" mode="aspectFill" aria-hidden="true"></image></view><view class="book-copy"><view class="book-meta"><text>{{item.genre}}</text><text>{{item.difficulty}}</text></view><view class="book-title">{{item.title}}</view><view class="book-teaser">{{item.teaser}}</view></view></button></view></view><view class="story-pagination"><button aria-label="上一题" bindtap="moveStory" data-direction="-1" disabled="{{storyIndex === 0}}">‹</button><text>{{puzzles.length ? storyIndex + 1 : 0}} / {{puzzles.length}} · 滑动选题 · 点击开始</text><button aria-label="下一题" bindtap="moveStory" data-direction="1" disabled="{{storyIndex >= puzzles.length - 1}}">›</button></view>
      <view class="route-status"><view class="status-dot {{statusKind}}"></view><text>{{statusText}}</text><button bindtap="load" disabled="{{loading}}">刷新</button></view>
      <view wx:if="{{error}}" class="route-error">{{error}}</view><button class="story-card route-primary" bindtap="start" data-id="{{puzzle ? puzzle.id : ''}}" disabled="{{!canStart || !puzzle}}">开始这个故事 <text>↗</text></button>
    </view>
  </block>
</view>
<view wx:if="{{privacyNeeded}}" class="paper-theme privacy-backdrop"><view class="privacy-dialog"><view class="privacy-title serif">开麦之前，先说清楚</view><view class="privacy-body">仅在你主动按住时录音。录音会发送到云端及第三方识别服务，转成文字供你确认。</view><button class="text-link" bindtap="privacy">阅读录音与隐私说明</button><button id="agree-privacy" class="primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agreePrivacy">同意并继续</button><button class="secondary" bindtap="declinePrivacy">暂不使用语音</button></view></view>
