.privacy-page{height:100vh;overflow:hidden;background:#f6f3eb;padding:22rpx 36rpx calc(20rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column}
.privacy-head{display:flex;justify-content:space-between;align-items:center;font-size:23rpx;color:#78876d;flex-shrink:0}.privacy-head button{font-size:25rpx;min-height:44px;color:#39553f}
.privacy-card{flex:1;min-height:0;display:flex;flex-direction:column;justify-content:center;padding:30rpx 0}
.privacy-page-title{font-size:44rpx;line-height:1.5;margin:18rpx 0;color:#2c4a38}
.privacy-paragraph{font-size:26rpx;line-height:1.85;margin-top:15rpx;color:#65795c}
.privacy-pagination{display:flex;align-items:center;justify-content:space-between;font-size:23rpx;flex-shrink:0;padding:9rpx 0}.privacy-pagination button{font-size:24rpx;min-height:44px}
.privacy-page .primary,.privacy-page .secondary{font-size:25rpx;width:100%;min-height:44px;flex-shrink:0;padding:20rpx;margin-top:10rpx}
@media(max-height:700px){.privacy-card{padding:10rpx 0}.privacy-page-title{font-size:35rpx;margin:14rpx 0}.privacy-paragraph{font-size:24rpx;line-height:1.75;margin-top:10rpx}}
