.privacy-page{padding:44rpx 39rpx calc(35rpx + env(safe-area-inset-bottom))}
.privacy-page-title{font-size:64rpx;line-height:1.35;font-weight:600;margin:24rpx 0 27rpx}
.privacy-page-title text{display:block}
.privacy-intro{font-size:27rpx;line-height:1.9;color:#75826b;margin-bottom:41rpx}
.privacy-section{position:relative;border-top:1rpx solid #d2dbc5;padding:27rpx 0 31rpx}
.privacy-no{position:absolute;right:0;top:33rpx;font-size:20rpx;color:#a3b094}
.privacy-section-title{font-size:35rpx;margin-bottom:19rpx;font-weight:600}
.privacy-paragraph{font-size:25rpx;color:#75826c;line-height:1.95;margin-top:15rpx}
.privacy-note{padding:25rpx;background:#ebe9d9;border-radius:13rpx;color:#8d8468;font-size:23rpx;line-height:1.9;margin:9rpx 0 28rpx}
.privacy-page .primary{margin-top:17rpx}
.privacy-page .secondary{font-size:24rpx}

.privacy-page{background:#f6f3eb;padding:37rpx 36rpx calc(35rpx + env(safe-area-inset-bottom))}
.privacy-page-title{font-size:62rpx}
.privacy-intro{font-size:28rpx;color:#687e60}
.privacy-section-title{font-size:35rpx}
.privacy-paragraph{font-size:27rpx;color:#657b5d}
.privacy-note{font-size:24rpx;color:#80724f;border-radius:17rpx;background:#eee8d7}
.privacy-page .primary,.privacy-page .secondary{width:100%;min-height:88rpx;font-size:26rpx}
