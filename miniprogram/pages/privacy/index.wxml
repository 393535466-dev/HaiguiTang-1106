<view class="privacy-page"><view class="privacy-head"><button bindtap="back">‹ 返回</button><text>录音与隐私说明</text></view><view class="privacy-card"><view class="eyebrow">BEFORE YOU SPEAK · {{sectionIndex + 1}} / {{sections.length}}</view><view class="privacy-page-title serif">{{section.title}}</view><view wx:for="{{section.paragraphs}}" wx:key="index" class="privacy-paragraph">{{item}}</view></view><view class="privacy-pagination"><button bindtap="moveSection" data-direction="-1" disabled="{{sectionIndex === 0}}">← 上一页</button><text>{{sectionIndex + 1}} / {{sections.length}}</text><button bindtap="moveSection" data-direction="1" disabled="{{sectionIndex === sections.length - 1}}">下一页 →</button></view><button class="secondary" bindtap="openPlatformPrivacy">查看微信隐私保护指引</button><button class="primary" bindtap="back">知道了，回到故事</button></view>
