.tutorial-page{height:100vh;display:flex;flex-direction:column}.tutorial-header{display:flex;align-items:center;justify-content:space-between;padding:30rpx 36rpx 12rpx}.tutorial-title{font-size:43rpx;font-weight:600;margin-top:5rpx}.skip-button{font-size:23rpx;padding:20rpx 0 20rpx 20rpx;color:#687b62}.practice-label{font-size:21rpx;color:#7b816d;margin:0 36rpx 20rpx}.step-list{display:flex;gap:10rpx;padding:0 36rpx 22rpx;border-bottom:1rpx solid #d4dccb}.step-item{flex:1;display:flex;gap:8rpx;align-items:center;color:#89947e;font-size:23rpx;white-space:nowrap}.step-no{display:inline-flex;width:33rpx;height:33rpx;border:1rpx solid #cbd3bf;border-radius:50%;align-items:center;justify-content:center;font-size:19rpx}.step-item.current{color:#214c3e;font-weight:600}.current .step-no{background:#214c3e;border-color:#214c3e;color:#fffdf5}.step-item.complete .step-no{background:#e0e6d5}.tutorial-scroll{flex:1;height:0;min-height:0;overflow-y:auto}.tutorial-content{padding:26rpx 36rpx 35rpx}.practice-story{background:#faf8f0;border:1rpx solid #d4dcc9;border-radius:17rpx;padding:22rpx 25rpx}.story-label{font-size:21rpx;color:#819074}.practice-surface{font-size:29rpx;line-height:1.8;margin-top:12rpx}.instruction-title{font-size:36rpx;font-weight:600;margin:31rpx 0 12rpx}.instruction-copy{font-size:25rpx;color:#71806a;line-height:1.8;margin:12rpx 0 21rpx}.teaching-note{font-size:25rpx;color:#78613c;line-height:1.8;background:#f0eadb;border-left:4rpx solid #b69b68;border-radius:0 12rpx 12rpx 0;padding:20rpx 23rpx;margin-top:20rpx}.example-choice{display:block;width:100%;text-align:left;font-size:25rpx;line-height:1.7;border:1rpx solid #cdd6c1;border-radius:12rpx;padding:18rpx 23rpx;margin-top:14rpx;background:#faf8f0}.example-choice.chosen{border-color:#42694d;background:#e9efdf}.practice-draft{margin-top:22rpx;border:1rpx dashed #9cad8d;padding:20rpx 23rpx;border-radius:12rpx}.draft-copy{font-size:26rpx;line-height:1.8;margin:9rpx 0 17rpx}.practice-send{font-size:24rpx;padding:19rpx 24rpx}.practice-answer{display:flex;flex-direction:column;align-items:flex-start;gap:17rpx;font-size:27rpx;line-height:1.8;padding:23rpx;border:1rpx solid #bbccb0;border-radius:14rpx;background:#e8eddf;margin-top:22rpx}.answer-tag{background:#d5e1ca;color:#315744;border-radius:8rpx;padding:5rpx 17rpx;font-weight:600}.voice-note{font-size:23rpx;line-height:1.8;color:#7c8770;margin-top:22rpx}.hint-action{width:100%;font-size:27rpx;margin-top:25rpx}.solution-title{font-size:35rpx;font-weight:600}.solved .voice-note{margin-top:0}.tutorial-footer{flex-shrink:0;padding:20rpx 36rpx calc(16rpx + env(safe-area-inset-bottom));border-top:1rpx solid #d4dccb;background:#f4f1e9}.tutorial-footer .primary{width:100%;font-size:27rpx;padding:24rpx}.footer-links{display:flex;justify-content:space-between;align-items:center;min-height:44rpx;margin-top:10rpx;color:#869078;font-size:21rpx}.footer-links button{font-size:23rpx;padding:10rpx 0}.footer-links text{margin-left:auto}.footer-reminder{padding:15rpx 0;text-align:center;font-size:25rpx;color:#6c7b61}
