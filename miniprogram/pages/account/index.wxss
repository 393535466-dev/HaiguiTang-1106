.account-page{height:100vh;overflow:hidden;background:#101111 url('/assets/brand/black-paper-v1.jpg') center / cover;padding:24rpx 32rpx;color:#e8ddc6}
.account-header{display:flex;align-items:center;gap:24rpx;min-height:56px;font-family:SoupHand,"Kaiti SC",serif;font-size:40rpx}
.account-header>button{font-size:48rpx;min-width:44px;min-height:44px;text-align:left}
.account-card{margin-top:35rpx;padding:34rpx 26rpx;border:12rpx solid transparent;border-image:url('/assets/brand/torn-kraft-v1.png') 120 120 100 120 fill / 46rpx 35rpx / 0 stretch;color:#342b20}
.account-title{font-family:SoupHand,"Kaiti SC",serif;font-size:39rpx;line-height:1.5}
.account-copy{font-family:SoupMincho,"Songti SC",serif;font-size:26rpx;line-height:1.75;color:#705c3d;margin:18rpx 0}
.account-label{font-size:26rpx;margin:24rpx 0 10rpx}
.nickname-field{width:100%;height:80rpx;min-height:44px;padding:12rpx 16rpx;font-size:30rpx;background:#e9d8b5;border:1px solid #ab936c;color:#342b20}
.paper-theme.account-page .primary{border:1px solid #ab936c;border-image:none;background:#cfb98e;width:100%;padding:18rpx;margin-top:25rpx;min-height:44px}
.account-link,.setting-row{display:flex;justify-content:space-between;width:100%;min-height:44px;padding:22rpx 0;text-align:left;font-size:30rpx;border-bottom:1px solid #a38a5e66;color:#473720}
.setting-row{margin-top:24rpx}.setting-value{font-family:SoupMincho,"Songti SC",serif;font-size:25rpx;color:#675136}
.account-error{font-size:24rpx;color:#85412e;margin-top:18rpx}
