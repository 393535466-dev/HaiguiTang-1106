.rank-scroll{height:100vh}.rank-page{padding:30rpx 36rpx 60rpx}.rank-title{font-size:52rpx;line-height:1.5;margin:18rpx 0}.rank-sub{font-size:24rpx;color:#7a8970;line-height:1.8}.rank-tabs{display:flex;background:#e8eddd;padding:7rpx;border-radius:13rpx;margin:32rpx 0}.rank-tabs button{flex:1;font-size:26rpx;padding:19rpx 10rpx;border-radius:9rpx}.rank-tabs button.selected{background:#fffdf5;box-shadow:0 3rpx 8rpx rgba(40,70,30,.08)}.my-score{background:#e2e9d5;border:1rpx solid #c9d6ba;border-radius:20rpx;padding:27rpx 30rpx;font-size:23rpx;color:#758568}.score-number{font-size:70rpx;line-height:1.3;color:#34563c;margin:12rpx 0}.score-number text{font-size:25rpx}.rank-heading{display:flex;justify-content:space-between;margin:34rpx 0 15rpx;color:#849277;font-size:22rpx}.rank-heading button{font-size:22rpx;color:#9a7450}.rank-row{display:flex;align-items:center;gap:20rpx;padding:23rpx 15rpx;border-bottom:1rpx solid #dce2d2}.rank-row.self{background:#eaf0df;border-radius:12rpx}.rank-position{font-size:36rpx;color:#8e9e7d;width:45rpx}.rank-player{flex:1;min-width:0;font-size:27rpx;word-break:break-all}.rank-player text{font-size:20rpx;color:#8a9780}.rank-points{font-size:26rpx;color:#45663c;flex-shrink:0}.rank-empty{font-size:25rpx;line-height:1.8;color:#8b987d;padding:35rpx 15rpx}.rank-rules{margin-top:40rpx;padding:25rpx;background:#edeadf;border-radius:14rpx}.rank-rules>view{font-size:28rpx;margin-bottom:12rpx}.rank-rules text{display:block;font-size:21rpx;line-height:1.85;color:#8b856c;margin-top:13rpx}
