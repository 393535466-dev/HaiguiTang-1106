<view class="rank-page">
  <view class="rank-top"><button class="text-link" bindtap="home">‹ 回到首页</button><text>好奇心俱乐部</text></view>
  <view wx:if="{{!rulesOpen}}" class="rank-hero"><view class="eyebrow">THE CURIOUS MINDS</view><view class="rank-title serif">好奇心，<text>有回响。</text></view><view class="rank-emblem" aria-hidden="true"><text class="serif">?</text><view>✦</view></view><view class="rank-sub">每一次认真推理，都值得被记住。</view></view>
  <block wx:if="{{!rulesOpen}}"><view class="rank-tabs"><button class="{{mode === 'solo' ? 'selected' : ''}}" data-mode="solo" bindtap="switchMode">单人榜</button><button class="{{mode === 'friends' ? 'selected' : ''}}" data-mode="friends" bindtap="switchMode">好友协作榜</button></view>
  <view class="my-score"><view class="my-score-label"><text>我的{{mode === 'friends' ? '协作' : '推理'}}成绩</text><text class="score-star">✦</text></view><view class="score-bottom"><view class="score-number serif">{{me ? me.points : 0}}<text> 分</text></view><view class="score-stats"><view><text>{{me ? me.wins : 0}}</text> 次成功</view><view><text>{{me ? me.played : 0}}</text> 次挑战</view></view></view></view>
  <view class="rank-heading"><view class="serif">{{mode === 'friends' ? '一起找到答案的人' : '追问真相的人'}}</view><button bindtap="load" disabled="{{loading}}">{{loading ? '更新中…' : '刷新'}}</button></view><view class="rank-description">积分前 20 人 · 同积分与胜场并列</view>
  <view wx:if="{{error}}" class="notice">{{error}}</view>
  <view wx:if="{{loading && !rows.length}}" class="rank-empty"><view class="empty-rank-mark serif">…</view><view>正在整理大家的推理成绩</view></view>
  <view wx:elif="{{!rows.length && !error}}" class="rank-empty"><view class="empty-rank-mark serif">?</view><view class="serif empty-rank-title">第一份好奇，等你留下。</view><view>完成一次首次挑战，成绩就会出现在这里。</view><button class="secondary" bindtap="home">去挑一碗汤 ↗</button></view>
  <view class="rank-list"><view wx:for="{{viewRows}}" wx:key="id" class="rank-row {{item.isMe ? 'self' : ''}} {{item.rank <= 3 ? 'leading' : ''}}"><text class="rank-position serif">{{item.rank}}</text><view class="rank-avatar">{{item.initial}}</view><view class="rank-player"><view>{{item.nickname}}<text wx:if="{{item.isMe}}" class="me-label">我</text></view><text>{{item.wins}} 次成功 · {{item.played}} 次挑战</text></view><view class="rank-points">{{item.points}}<text>积分</text></view></view></view>
  <view class="rank-pagination"><button bindtap="movePage" data-direction="-1" disabled="{{pageIndex === 0}}">← 上一页</button><text>{{pageIndex + 1}} / {{pageCount}}</text><button bindtap="movePage" data-direction="1" disabled="{{pageIndex + 1 >= pageCount}}">下一页 →</button></view><button class="text-link" bindtap="toggleRules">积分怎么算？ ↗</button></block>
  <view wx:else class="rank-rules"><view class="rules-title serif">每一分，都有来由。</view><view class="rule-copy">{{rules[ruleIndex]}}</view><view class="rank-pagination"><button bindtap="moveRule" data-direction="-1" disabled="{{ruleIndex === 0}}">← 上一页</button><text>{{ruleIndex + 1}} / {{rules.length}}</text><button bindtap="moveRule" data-direction="1" disabled="{{ruleIndex === rules.length - 1}}">下一页 →</button></view><button class="primary" bindtap="toggleRules">返回排行榜</button></view>
  <view class="rank-footer">答案不靠抢，好奇心不分先后。</view>
</view>
