.room-page{height:100vh;display:flex;flex-direction:column;background:#f4f1e9}.room-header{display:flex;align-items:center;gap:20rpx;padding:22rpx 30rpx;flex-shrink:0}.room-header>button:first-child{font-size:48rpx}.room-header>view{flex:1;min-width:0}.room-title{font-size:32rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.room-header .eyebrow{font-size:15rpx;letter-spacing:2rpx}.small-link{font-size:21rpx;color:#8d6d4d}.room-loading{padding:60rpx}.room-setup{height:0;flex:1;padding:5rpx 34rpx 40rpx}.setup-copy{font-size:24rpx;color:#7b8973;line-height:1.8;margin:12rpx 0 20rpx}.field-label{font-size:23rpx;margin:25rpx 0 10rpx}.short-field{width:100%;height:80rpx;background:#fffdf7;border:1rpx solid #cbd4bf;border-radius:12rpx;padding:17rpx 22rpx;font-size:27rpx;color:#304c3c}.code-field{margin:22rpx 0}.setup-panel{padding:30rpx;margin:24rpx 0;background:#faf8ef;border:1rpx solid #d8dfcf;border-radius:20rpx}.panel-title{font-size:33rpx;margin-bottom:18rpx}.puzzle-option{display:flex;justify-content:space-between;gap:12rpx;width:100%;padding:19rpx 20rpx;border:1rpx solid #d7dfcd;border-radius:10rpx;margin-bottom:12rpx;font-size:25rpx;text-align:left}.puzzle-option text:last-child{font-size:19rpx;color:#7b8e6c}.puzzle-option.selected{border-color:#5c7d53;background:#e8eddd}.setup-panel .primary,.setup-panel .secondary{width:100%;margin-top:22rpx}.room-code-line{display:flex;justify-content:space-between;padding:0 32rpx 12rpx;font-size:21rpx;color:#7b8b70}.room-code-line button{font-size:21rpx;color:#8b6951}.room-members{display:flex;flex-wrap:wrap;gap:8rpx;padding:0 30rpx 12rpx;flex-shrink:0}.member-chip{background:#e7ebdf;border:1rpx solid transparent;padding:8rpx 14rpx;border-radius:10rpx;font-size:19rpx;max-width:100%}.member-chip.me{border-color:#87a176}.member-state{display:block;font-size:15rpx;color:#859179}.room-surface{margin:0 30rpx;background:#e9ecde;border-radius:12rpx;padding:13rpx 20rpx;flex-shrink:0}.room-surface button{font-size:18rpx;color:#80916e}.surface-text{font-size:24rpx;line-height:1.7;max-height:82rpx;overflow:hidden}.surface-text.expanded{max-height:210rpx;overflow:auto}.turn-banner{display:flex;align-items:center;justify-content:space-between;gap:12rpx;background:#dfe8d2;margin:0 30rpx;padding:15rpx 17rpx;border-radius:10rpx;font-size:22rpx;flex-shrink:0}.turn-banner button,.turn-banner text:last-child{font-size:20rpx}.room-ledger{padding:10rpx 32rpx 5rpx;font-size:17rpx;color:#8b967e;flex-shrink:0}.room-messages{flex:1;height:0;min-height:100rpx;padding:10rpx 32rpx}.empty-discussion{padding:40rpx 15rpx;text-align:center;color:#8b967e;font-size:24rpx}.room-message{margin:12rpx 0;padding:17rpx 20rpx;border-radius:12rpx;background:#fffdf7;border:1rpx solid #e0e4d7}.room-message.discussion{background:#ecefe4;margin-right:30rpx}.message-author{font-size:18rpx;color:#8b987d;margin-bottom:6rpx}.message-text{font-size:25rpx;line-height:1.7;word-break:break-all;white-space:pre-wrap}.room-message.system{background:transparent;border:0;text-align:center;color:#929b84;padding:8rpx}.room-message.system .message-text{font-size:19rpx}.host-reply{margin-top:12rpx;padding-top:12rpx;border-top:1rpx dashed #d5decb;font-size:22rpx;color:#5b7650;line-height:1.6}.host-name{display:block;font-size:17rpx;margin-bottom:4rpx;color:#8c9b7b}.room-composer{border-top:1rpx solid #d5ddca;padding:12rpx 28rpx calc(10rpx + env(safe-area-inset-bottom));background:#faf8f0;flex-shrink:0}.room-modes{display:flex;gap:6rpx;margin-bottom:10rpx;background:#e9eddd;border-radius:10rpx;padding:5rpx}.room-modes button{font-size:22rpx;padding:11rpx 10rpx;flex:1;border-radius:7rpx}.room-modes button.selected{background:#fffdf7;color:#34563f}.room-draft{width:100%;height:80rpx;padding:12rpx 18rpx;border:1rpx solid #cad6be;border-radius:10rpx;background:#fffdf8;font-size:25rpx;line-height:1.6;color:#34543d}.room-input-actions{display:flex;gap:12rpx;margin-top:11rpx}.room-input-actions button{flex:1;font-size:24rpx;padding:19rpx 12rpx;letter-spacing:0}.room-record{touch-action:none;user-select:none;-webkit-user-select:none}.room-record.recording{background:#dce7cc}.room-bottom{display:flex;gap:18rpx;align-items:center;justify-content:flex-end;margin-top:9rpx}.room-bottom button{font-size:18rpx;padding:4rpx;color:#8d8068}.room-bottom.finished{padding:15rpx 30rpx;justify-content:space-between}.room-error{background:#f2e5da;color:#9f6148;border-radius:10rpx;padding:14rpx 18rpx;font-size:22rpx;line-height:1.6}.room-error.compact{margin:5rpx 30rpx;flex-shrink:0;max-height:100rpx;overflow:auto}.room-system{font-size:20rpx;color:#8a8e77;padding:4rpx}.room-ending{padding:28rpx 24rpx;background:#e7edda;border-radius:16rpx;margin:15rpx 0;font-size:25rpx;line-height:1.85}.score-line{font-size:21rpx;margin:22rpx 0;color:#6d805c}.room-ending .primary{font-size:24rpx;width:100%}.room-end-marker{height:10rpx}
