<view class="paper-theme room-page">
  <view class="room-header"><button class="room-back" bindtap="home" aria-label="返回首页">‹</button><view class="room-heading"><view class="serif room-title">{{room ? room.title : '好奇心，凑一桌。'}}</view></view><view class="header-tools"><button class="tool-button" bindtap="profile" aria-label="我的" disabled="{{recording || busy}}"><view class="tool-person" aria-hidden="true"></view></button><button class="tool-button" bindtap="leaderboard" aria-label="排行榜" disabled="{{recording || busy}}"><image src="/assets/brand/ranking-coin-v1.png" mode="aspectFit" aria-hidden="true"></image></button><button class="tool-button" bindtap="settings" aria-label="设置" disabled="{{recording || busy}}"><view class="tool-settings" aria-hidden="true"><view></view><view></view><view></view></view></button></view></view>
  <view wx:if="{{loading}}" class="room-loading"><view class="loading-orbit serif">汤</view><view>正在准备好友桌…</view></view>
  <view wx:elif="{{!room}}" class="room-setup">
    <view class="setup-copy lobby-capabilities">2～6 人 · 每轮 45 秒 · 文字 / 语音</view><view class="profile-line"><view class="field-label">你的称呼</view><textarea class="short-field" value="{{nickname}}" bindinput="nicknameInput" maxlength="12" placeholder="输入昵称，最多12字" auto-height="false" adjust-position="true" cursor-spacing="24" show-confirm-bar="false"></textarea></view><view class="lobby-tabs"><button class="{{lobbyMode === 'create' ? 'selected' : ''}}" data-mode="create" bindtap="switchLobby">我来组一桌</button><button class="{{lobbyMode === 'join' ? 'selected' : ''}}" data-mode="join" bindtap="switchLobby">加入好友房</button></view>
    <view wx:if="{{lobbyMode === 'create'}}" class="setup-panel"><view class="story-carousel room-story-carousel" aria-label="左右滑动选择剧本"><view class="story-deck {{carouselDragging ? 'dragging' : ''}}" style="transform:translateX({{carouselShift}}px)"><button wx:for="{{carouselCards}}" wx:key="id" class="story-leaf {{item.position}}" data-index="{{item.index}}" bindtap="selectStoryCard" bindtouchstart="storyTouchStart" catchtouchmove="storyTouchMove" bindtouchend="storyTouchEnd" bindtouchcancel="storyTouchCancel" aria-label="{{item.index === puzzleIndex ? '创建《' + item.title + '》好友房' : '选择《' + item.title + '》'}}" aria-pressed="{{item.index === puzzleIndex}}"><image class="book-paper" src="/assets/brand/story-paper-v1.png" mode="scaleToFill" aria-hidden="true"></image><view class="book-picture"><image class="book-art" src="{{item.art}}" mode="aspectFill" aria-hidden="true"></image></view><view class="book-copy"><view class="book-meta"><text>{{item.genre}}</text><text>{{item.difficulty}}</text></view><view class="book-title">{{item.title}}</view><view class="book-teaser">{{item.teaser}}</view></view></button></view></view><view class="puzzle-pagination"><button aria-label="上一题" bindtap="movePuzzle" data-direction="-1" disabled="{{puzzleIndex === 0 || busy}}">‹</button><text>{{puzzles.length ? puzzleIndex + 1 : 0}} / {{puzzles.length}} · 滑动选题 · 点击建房</text><button aria-label="下一题" bindtap="movePuzzle" data-direction="1" disabled="{{puzzleIndex >= puzzles.length - 1 || busy}}">›</button></view><button class="primary" bindtap="create" disabled="{{busy || !selectedPuzzle}}">{{busy ? '正在准备房间…' : '创建好友房'}}</button></view>
    <view wx:else class="setup-panel join-panel"><view class="serif panel-title">给你留了个座位。</view><view class="setup-copy">填入朋友发来的六位房间号，就能入座。</view><textarea class="short-field code-field" value="{{roomCode}}" bindinput="codeInput" maxlength="6" placeholder="输入六位房间号" auto-height="false" adjust-position="true" cursor-spacing="24" show-confirm-bar="false"></textarea><button class="primary" bindtap="join" disabled="{{busy || roomCode.length !== 6}}">{{busy ? '正在加入…' : '加入房间'}}</button></view>
    <view wx:if="{{error}}" class="room-error">{{error}}</view><view class="lobby-note">创建后，把六位房间号告诉朋友。</view>
  </view>
  <block wx:else>
    <view class="room-code-line"><view><text class="room-code-label">房间号</text><text class="room-code-number">{{room.id}}</text><text class="room-count">{{room.members.length}} / 6 人</text></view><button bindtap="copyCode">复制房间号</button></view>
    <view class="room-members"><view wx:for="{{room.members}}" wx:key="id" class="member-chip {{item.isMe ? 'me' : ''}}"><view class="member-avatar">{{item.initial}}<view class="online-dot {{item.online ? 'online' : ''}}"></view></view><view class="member-label"><text>{{item.nickname}}{{item.isMe ? '（我）' : ''}}</text><text class="member-state">{{item.isHost ? '房主' : (item.online ? '已入座' : '暂离')}}</text></view></view></view>
    <view class="host-voice-bar"><button bindtap="toggleHostVoice" disabled="{{recording}}">{{hostVoiceEnabled ? '人声已开 · 关闭' : '开启自然人声'}}</button><button bindtap="readSurface" disabled="{{recording}}">听题</button><button bindtap="replayHostVoice" disabled="{{recording}}">重播</button></view><view wx:if="{{hostVoiceStatus}}" class="host-voice-status">{{hostVoiceStatus}}</view>
    <view class="room-ledger"><text>提问 {{room.maxQuestions - room.questionCount}} / {{room.maxQuestions}}</text><text>提示 {{room.hintCount}} / 3</text><text>{{room.state === 'waiting' ? '开局确认计分' : (room.ranked ? '首次挑战' : '轻松重玩')}}</text></view>
    <view wx:if="{{room.state === 'waiting'}}" class="turn-banner waiting"><view><view class="turn-title">等朋友入座</view><view class="turn-note">至少两人，就可以开始。</view></view><button wx:if="{{room.isHost}}" bindtap="start" disabled="{{busy || room.members.length < 2}}">开始推理 ↗</button><text wx:else class="turn-note">等房主开始</text></view>
    <view wx:elif="{{room.state === 'playing'}}" class="turn-banner {{room.myTurn ? 'my-turn' : ''}} {{seconds <= 10 && !room.active ? 'ending-turn' : ''}}"><view class="turn-clock"><text>{{room.active ? '···' : seconds}}</text><text>{{room.active ? '判断中' : '秒'}}</text></view><view class="turn-main"><view class="turn-title">{{room.active ? 'AI 主持正在判断' : (room.myTurn ? '轮到你提问了' : '轮到 ' + room.turnName)}}</view><view class="turn-note">{{room.active ? '等候期间，大家可以继续讨论' : (room.myTurn ? '一次问一件事，也可以直接猜底' : '有新想法？可以先和大家讨论')}}</view></view><button wx:if="{{room.myTurn}}" bindtap="skip" disabled="{{busy}}">跳过</button></view>
    <view class="conversation-paper"><scroll-view class="room-messages" scroll-y scroll-into-view="{{scrollTarget}}" scroll-with-animation>
    <view class="room-surface" id="room-story-surface"><button bindtap="toggleSurface"><text>故 事 汤 面</text><text>{{surfaceExpanded ? '收起 −' : '展开 +'}}</text></button><view class="serif surface-text {{surfaceExpanded ? 'expanded' : ''}}">{{room.surface}}</view></view>
      <view wx:for="{{room.messages}}" wx:key="id" class="room-message {{item.type}} {{item.isMe ? 'own-message' : ''}}">
        <view wx:if="{{item.type !== 'system'}}" class="message-author"><text>{{item.nickname}}{{item.isMe ? '（我）' : ''}}</text><text class="message-kind">{{item.type === 'discussion' ? '讨论' : (item.type === 'question' ? '正式提问' : '完整猜底')}}</text></view><view class="message-text">{{item.text}}</view>
        <view wx:if="{{item.answer}}" class="host-reply"><view class="host-name"><text class="host-avatar">汤</text><text>AI 主持</text></view><view class="host-verdict {{item.isPositive ? 'positive' : ''}}">{{item.answerLabel}}</view><view class="host-note">{{item.answerNote}}</view></view>
      </view>
      <view wx:if="{{room.active}}" class="room-system">{{room.active.status === 'unknown' ? '结果尚未确认，可以查询原结果或跳过。' : '主持人正在对照故事线索…'}}</view>
      <view wx:if="{{room.solution}}" class="room-ending"><view class="ending-badge">{{room.state === 'solved' ? '一起找到了' : '故事已揭晓'}}</view><view class="serif panel-title">{{room.state === 'solved' ? '我们找到真相了。' : '故事的另一面。'}}</view><view class="room-solution">{{room.solution}}</view><view class="team-score"><text class="serif">{{room.points}}</text><view>本局共同得分<text>{{room.ranked ? '已记入你的好友协作榜' : '本次重玩不重复计分'}}</text></view></view><button class="primary" bindtap="leaderboard">看看好友协作榜 ↗</button></view>
      <view id="room-message-end" class="room-end-marker"></view>
    </scroll-view></view>
    <view wx:if="{{error || connection}}" class="room-error compact">{{error || connection}}</view>
    <view wx:if="{{room.state === 'playing' || room.state === 'waiting'}}" class="room-composer {{recording ? 'is-recording' : ''}}">
      <view class="room-modes"><button class="{{mode === 'discussion' ? 'selected' : ''}}" data-mode="discussion" bindtap="switchMode">和大家讨论</button><button class="{{mode === 'question' ? 'selected' : ''}}" data-mode="question" bindtap="switchMode" disabled="{{!room.myTurn}}">向 AI 提问</button><button class="{{mode === 'guess' ? 'selected' : ''}}" data-mode="guess" bindtap="switchMode" disabled="{{!room.myTurn}}">我猜到了</button></view>
      <view wx:if="{{mode !== 'discussion' && !room.myTurn}}" class="room-system">你的草稿已保留，轮到你时再提交。</view>
      <view wx:if="{{voiceError || voiceStatus}}" class="room-system">{{voiceError || voiceStatus}}</view><button wx:if="{{voicePending}}" class="small-link" bindtap="checkVoice">检查转写结果</button><button wx:if="{{recoveredTranscript}}" class="small-link" bindtap="useTranscript">使用刚才的识别文字</button>
      <view class="room-input-box"><view class="input-caption"><text>{{recording ? (cancelling ? '松手即可取消' : '正在听你说 · 上滑取消') : (mode === 'discussion' ? '讨论只发给房间里的朋友' : '确认后，交给 AI 主持')}}</text><text>{{draft.length}} / {{mode === 'guess' ? 500 : 200}}</text></view><textarea class="room-draft" value="{{draft}}" bindinput="input" maxlength="{{mode === 'guess' ? 500 : 200}}" placeholder="{{mode === 'discussion' ? '和朋友聊聊你的猜想…' : (mode === 'guess' ? '讲清人物、经过和原因…' : '一次问一个是非问题…')}}" disabled="{{recording}}" adjust-position="true" cursor-spacing="24" show-confirm-bar="false"></textarea></view>
      <view class="room-input-actions"><button class="secondary room-record {{recording ? 'recording' : ''}}" bindtouchstart="recordStart" catchtouchmove="recordMove" bindtouchend="recordEnd" bindtouchcancel="recordCancel" disabled="{{busy || voiceBusy || voicePending}}"><text class="record-symbol" aria-hidden="true">◉</text>{{recording ? (cancelling ? '松手取消' : '录音 ' + recordSeconds + ' 秒') : '按住说话'}}</button><button class="primary" bindtap="submit" disabled="{{busy || recording || !draft || (mode !== 'discussion' && (!room.myTurn || pending || room.active))}}">{{busy ? '正在发送…' : (mode === 'discussion' ? '发送讨论' : (mode === 'guess' ? '提交猜底' : '确认提问'))}}<text aria-hidden="true">↑</text></button></view>
      <view class="room-bottom"><button wx:if="{{pending}}" bindtap="checkResult">查询原结果</button><button wx:if="{{room.myTurn}}" bindtap="hint" disabled="{{room.hintCount >= 3 || busy || room.active}}">✦ 解锁提示</button><button wx:if="{{room.isHost && room.state === 'playing'}}" bindtap="reveal">结束并揭底</button><button bindtap="leave">退出房间</button></view>
    </view>
    <view wx:else class="room-bottom finished"><button bindtap="home">回到首页</button><button bindtap="leave">离开这桌</button></view>
  </block>
</view>
<view wx:if="{{privacyNeeded}}" class="paper-theme privacy-backdrop"><view class="privacy-dialog"><view class="privacy-title serif">开麦之前，先说清楚</view><view class="privacy-body">录音先转文字，由你核对后发送。发送讨论时，房间成员会看到确认的文字。</view><button class="text-link" bindtap="privacy">录音与隐私说明</button><button id="agree-privacy" class="primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agreePrivacy">同意并继续</button><button class="secondary" bindtap="declinePrivacy">暂不使用语音</button></view></view>
